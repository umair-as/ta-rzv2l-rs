...@house-style
direction: down

# Runtime components and trust boundaries. This deliberately shows the
# current platform defect: the logical Secure World boundary exists, but the
# DDR firewall does not prevent normal-world root from reading TZDRAM.

dev: Development computer\nbuild · deploy · verify {
  class: external
}

board: RZ/V2L board {
  class: boundary
  direction: right
  grid-columns: 2

  normal: Normal world · Linux / REE {
    class: boundary
    direction: down
    grid-columns: 1

    client: signer-client\nGetPubkey · Sign {class: box}
    root: root + /dev/mem\nOP-TEE code read succeeds {class: untrusted}
    supplicant: tee-supplicant\nstorage RPC {class: box}
    store: /var/lib/tee\nencrypted key blob {class: store}

    supplicant -> store: {class: aside}
  }

  secure: Secure world · OP-TEE {
    class: boundary
    direction: down

    core: OP-TEE OS {class: trusted}
    ta: signer TA\nkey in TA memory while used {class: focus}

    core -> ta: dispatch {class: flow}
  }
}

dev <-> board.normal.client: CLI · JSON {class: flow}
board.normal.client <-> board.secure.core: {class: flow}
board.normal.supplicant <-> board.secure.core: {class: aside}
board.normal.root -> board.secure.core: {class: exposed}
